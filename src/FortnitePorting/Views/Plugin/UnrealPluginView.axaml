<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ext="clr-namespace:FortnitePorting.Extensions;assembly=FortnitePorting"
             xmlns:plugin="clr-namespace:FortnitePorting.ViewModels.Plugin"
             xmlns:material="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:controls="clr-namespace:FortnitePorting.Controls"
             xmlns:pluginControls="clr-namespace:FortnitePorting.Controls.Plugin"
             xmlns:settingsControls="clr-namespace:FortnitePorting.Controls.Settings"
             xmlns:plugin1="clr-namespace:FortnitePorting.Views.Plugin"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="FortnitePorting.Views.Plugin.UnrealPluginView"
             x:DataType="plugin:UnrealPluginViewModel">
    <ScrollViewer>
        <StackPanel VerticalAlignment="Top" Margin="{ext:Space 2, 2, 2, 1}">
            <pluginControls:PluginInstallationsHeader
                Title="Unreal Engine"
                Subtitle="{Binding Installations.Count, StringFormat='{}{0} Project(s) Registered'}"
                AddButtonContent="{controls:IconText 'Add Project', Plus}" />

            <Separator Background="{DynamicResource FPSeparatorColorLayer1}" Margin="{ext:Space 0, 2, 0, 0}" />

            <StackPanel Spacing="{ext:Space 2}" Margin="{ext:Space 0, 2, 0, 0}">
                <StackPanel IsVisible="{Binding !!Installations.Count}"
                            Spacing="{ext:Space 0, 0, 0, 1}">
                    <TextBlock Text="Installations"
                               Classes="SettingsSectionHeaderStyle TextFillColorTertiaryBrush"
                               HorizontalAlignment="Left"
                               Margin="{ext:Space 1, 0, 0, 0}" />

                    <ItemsControl ItemsSource="{Binding Installations}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <controls:ContentCard Padding="{ext:Space 2}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="{ext:Space 1}" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="{ext:Space 1}" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" CornerRadius="12" ClipToBounds="True">
                                    <Image Source="{Binding Image}" Width="48" Height="48"
                                           RenderOptions.BitmapInterpolationMode="HighQuality" />
                                </Border>

                                <Grid Grid.Column="2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="{ext:Space 0.5}" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="{ext:Space 1}">
                                        <TextBlock Text="{Binding Name}"
                                                   Classes="BodyStrongTextBlockStyle" VerticalAlignment="Center" />

                                        <Border CornerRadius="12" Padding="{ext:Space 1, 0.5}"
                                                HorizontalAlignment="Left" ClipToBounds="False"
                                                Background="{Binding StatusBrush}">
                                            <TextBlock Text="{Binding Status, Converter={StaticResource EnumToString}}"
                                                       FontFamily="{StaticResource SFTextSemiBold}"
                                                       FontSize="12" Foreground="White" />
                                        </Border>

                                        <TextBlock Text="{Binding VersionString}"
                                                   Classes="CaptionTextBlockStyle TextFillColorSecondaryBrush"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>

                                    <TextBlock Grid.Row="2" Text="{Binding ProjectFilePath}"
                                               Classes="BodyTextBlockStyle TextFillColorTertiaryBrush"
                                               VerticalAlignment="Center" />
                                </Grid>

                                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="{ext:Space 1}">
                                    <Button Content="{material:MaterialIconExt Launch}" Command="{Binding Launch}" />
                                    <Button Content="{material:MaterialIconExt Close}"
                                            Command="{Binding $parent[plugin1:UnrealPluginView].((plugin:UnrealPluginViewModel)DataContext).RemoveInstallation}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </controls:ContentCard>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="{ext:Space 0, 0, 0, 1}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Spacing="{ext:Space 0, 0, 0, 1}">
                    <TextBlock Text="Settings"
                               Classes="SettingsSectionHeaderStyle TextFillColorTertiaryBrush"
                               HorizontalAlignment="Left"
                               Margin="{ext:Space 1, 0, 0, 0}" />

                    <settingsControls:SettingsItem Title="Auto-Sync"
                                                   Description="Automatically syncs the Unreal plugin after Fortnite Porting updates.">
                        <settingsControls:SettingsItem.Footer>
                            <ToggleSwitch IsChecked="{Binding AutomaticallySync}" />
                        </settingsControls:SettingsItem.Footer>
                    </settingsControls:SettingsItem>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
