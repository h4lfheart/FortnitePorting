<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:material="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:ext="clr-namespace:FortnitePorting.Extensions"
             xmlns:controls="clr-namespace:FortnitePorting.Controls"
             xmlns:sidebar="clr-namespace:FortnitePorting.Controls.Navigation.Sidebar"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="FortnitePorting.Controls.Navigation.Sidebar.SidebarItemButton"
             Margin="{ext:Space -1, -0.5}" ClipToBounds="False">

    <UserControl.Styles>
        <Style Selector="sidebar|SidebarItemButton:disabled">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
    </UserControl.Styles>

    <StackPanel Spacing="{ext:Space 1}" ClipToBounds="False">
        <Grid Cursor="Hand" ColumnDefinitions="* Auto">

            <Panel Grid.Column="0">
                <controls:ContentCard CornerRadius="16" ClipToBounds="False"
                                      Classes.Selected="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=sidebar:SidebarItemButton}, FallbackValue=False}"
                                      Classes.NotSelected="{Binding !IsSelected, RelativeSource={RelativeSource AncestorType=sidebar:SidebarItemButton}, FallbackValue=True}">
                    <controls:ContentCard.Transitions>
                        <Transitions>
                            <BrushTransition Property="Background" Duration="0:0:0.083" />
                            <DoubleTransition Property="Opacity" Duration="0:0:0.083" />
                        </Transitions>
                    </controls:ContentCard.Transitions>
                    <controls:ContentCard.Styles>
                        <Style Selector="controls|ContentCard.Selected">
                            <Setter Property="Background" Value="{DynamicResource FPButtonBackground}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource FPButtonBorderBrush}" />
                            <Setter Property="Opacity" Value="1" />
                        </Style>
                        <Style Selector="controls|ContentCard.Selected:pointerover">
                            <Setter Property="Background" Value="{DynamicResource FPButtonBackgroundPointerOver}" />
                            <Setter Property="Opacity" Value="1" />
                        </Style>

                        <Style Selector="controls|ContentCard.NotSelected">
                            <Setter Property="Opacity" Value="0" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="BoxShadow" Value="none" />
                        </Style>
                        <Style Selector="controls|ContentCard.NotSelected:pointerover">
                            <Setter Property="Background" Value="{DynamicResource FPButtonBackgroundPointerOver}" />
                            <Setter Property="Opacity" Value="0.5" />
                            <Setter Property="BoxShadow" Value="none" />
                        </Style>
                    </controls:ContentCard.Styles>
                </controls:ContentCard>

                <Grid ColumnDefinitions="Auto * Auto Auto" Margin="{ext:Space 1, 0.5}">
                    <Grid Grid.Column="0" IsHitTestVisible="False"
                          IsVisible="{Binding ShouldShowIcon, RelativeSource={RelativeSource AncestorType=sidebar:SidebarItemButton}}">
                        <material:MaterialIcon
                            IsVisible="{Binding IconBitmap, RelativeSource={RelativeSource AncestorType=sidebar:SidebarItemButton}, Converter={x:Static ObjectConverters.IsNull}}"
                            Kind="{Binding Icon, RelativeSource={RelativeSource AncestorType=sidebar:SidebarItemButton}}" />

                        <Border Width="20" Height="20" ClipToBounds="True" CornerRadius="4"
                                IsVisible="{Binding IconBitmap, RelativeSource={RelativeSource AncestorType=sidebar:SidebarItemButton}, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <Image Width="20" Height="20" RenderOptions.BitmapInterpolationMode="HighQuality"
                                   Source="{Binding IconBitmap, RelativeSource={RelativeSource AncestorType=sidebar:SidebarItemButton}}" />
                        </Border>
                    </Grid>

                    <TextBlock Grid.Column="1" IsHitTestVisible="False"
                               Text="{Binding Text, RelativeSource={RelativeSource AncestorType=sidebar:SidebarItemButton}}"
                               FontFamily="{StaticResource SFTextRegular}" Margin="{ext:Space 1, 0, 0, 0}"
                               Classes="TextFillColorSecondaryBrush" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />

                    <controls:ContentCard Grid.Column="2"
                                          IsHitTestVisible="False"
                                          ClipToBounds="False"
                                          IsVisible="{Binding !!NotificationCount, RelativeSource={RelativeSource AncestorType=sidebar:SidebarItemButton}}"
                                          Padding="{ext:Space 1.25, 0.5}"
                                          MinHeight="0"
                                          Background="{DynamicResource FPButtonBackgroundBright}"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Right">
                        <TextBlock
                            Text="{Binding NotificationCount, RelativeSource={RelativeSource AncestorType=sidebar:SidebarItemButton}}"
                            Classes="CaptionTextBlockStyle TextFillColorSecondaryBrush" />
                    </controls:ContentCard>

                    <Button Grid.Column="3"
                            Classes="GhostButton"
                            Padding="{ext:Space 0.75, 0}"
                            Margin="{ext:Space 0.5, 0, 0, 0}"
                            MinWidth="0"
                            MinHeight="0"
                            VerticalAlignment="Stretch"
                            HorizontalAlignment="Right"
                            Cursor="Hand"
                            IsVisible="{Binding HasItems, RelativeSource={RelativeSource AncestorType=sidebar:SidebarItemButton}}"
                            Command="{Binding ToggleExpandedCommand, RelativeSource={RelativeSource AncestorType=sidebar:SidebarItemButton}}"
                            PointerPressed="OnChevronPointerPressed">
                        <material:MaterialIcon
                            Kind="{Binding ChevronIcon, RelativeSource={RelativeSource AncestorType=sidebar:SidebarItemButton}}"
                            Width="16" Height="16"
                            Foreground="{DynamicResource TextFillTertiaryBrush}" />
                    </Button>
                </Grid>
            </Panel>

            <ContentPresenter Grid.Column="1" HorizontalAlignment="Right" Margin="{ext:Space 1, 0, 0, 0}"
                              IsVisible="{Binding Footer, 
                              RelativeSource={RelativeSource AncestorType=sidebar:SidebarItemButton}, 
                              Converter={x:Static ObjectConverters.IsNotNull}}"
                              Content="{Binding Footer, RelativeSource={RelativeSource AncestorType=sidebar:SidebarItemButton}}" />
        </Grid>

        <ItemsControl ItemsSource="{Binding Items, RelativeSource={RelativeSource AncestorType=sidebar:SidebarItemButton}}"
                      IsVisible="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=sidebar:SidebarItemButton}}"
                      Padding="{ext:Space 2, 0, 1, 0}"
                      Margin="{ext:Space 0, 0, 0, 0.5}"
                      ClipToBounds="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical" Spacing="{ext:Space 1.5}" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
    </StackPanel>
</UserControl>
